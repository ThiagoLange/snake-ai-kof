// server/server.kof — front 100% em Kof: serve o replay da IA (kof.web).
// Run da raiz do projeto: kof run server/server.kof
// Depois abra http://localhost:8888 no navegador.
// O JS vai em /app.js separado: o CSP padrão do kof.web bloqueia <script> inline.
// Requer frames.json gerado pelo treino (kof run snake_ai.kof).
// Target: JVM (kof.web server).

playerPage(): String {
    var html = ""
    html = html + "<!DOCTYPE html>\n<html lang='pt-BR'>\n<head>\n<meta charset='UTF-8'/>\n"
    html = html + "<title>Cobrinha IA - servidor Kof</title>\n"
    html = html + "<style>body{font-family:sans-serif;margin:24px;background:#f5f5f5} h1{color:#1b5e20;text-align:center} .card{background:#fff;padding:16px;border-radius:8px;box-shadow:0 1px 4px #ccc;max-width:560px;margin:0 auto} canvas{border:2px solid #1b5e20;background:#111} .stats{display:grid;grid-template-columns:auto auto;gap:4px 16px;margin:8px 0} button{margin:4px;padding:6px 12px;font-size:14px} </style>\n"
    html = html + "</head>\n<body>\n"
    html = html + "<h1>Cobrinha IA - servida por Kof (kof.web)</h1>\n"
    html = html + "<div class='card'>\n<canvas id='board' width='480' height='480'></canvas>\n"
    html = html + "<div><button id='playBtn'>Pausar</button><button id='restartBtn'>Reiniciar</button> Velocidade: <input id='speed' type='range' min='30' max='800' value='150'/></div>\n"
    html = html + "<div>Evolucao: <select id='epSel'></select> <b id='demoLbl'></b></div>\n"
    html = html + "<div class='stats'><span>Passo:</span><b id='stepLbl'>carregando...</b><span>Pontos:</span><b id='scoreLbl'>-</b></div>\n"
    html = html + "<div class='stats'><span>Treino:</span><b id='metaLbl'>-</b></div>\n"
    html = html + "</div>\n"
    html = html + "<div class='card'>\n<h2>Treino ao vivo</h2>\n"
    html = html + "<canvas id='live' width='560' height='220'></canvas>\n"
    html = html + "<div class='stats'><span>Episodio:</span><b id='liveEp'>-</b><span>Placar:</span><b id='liveScore'>-</b><span>Melhor:</span><b id='liveBest'>-</b></div>\n"
    html = html + "<p>Rode <code>kof run snake_ai.kof</code> em outro terminal para ver o aprendizado acontecendo.</p>\n"
    html = html + "</div>\n"
    html = html + "<script src='/app.js'></script>\n</body>\n</html>\n"
    return html
}

playerJs(): String {
    var js = ""
    js = js + "var DEMOS=[],FRAMES=[],SCORES=[],W=12,H=12,CELL=40;\n"
    js = js + "var idx=0,playing=true,speed=150,timer=null;\n"
    js = js + "var board=document.getElementById('board');\n"
    js = js + "var ctx=board.getContext('2d');\n"
    js = js + "function draw(i){\n"
    js = js + "ctx.fillStyle='#111';ctx.fillRect(0,0,board.width,board.height);\n"
    js = js + "ctx.strokeStyle='#444';\n"
    js = js + "for(var gx=0;gx<=W;gx++){ctx.beginPath();ctx.moveTo(gx*CELL,0);ctx.lineTo(gx*CELL,H*CELL);ctx.stroke();}\n"
    js = js + "for(var gy=0;gy<=H;gy++){ctx.beginPath();ctx.moveTo(0,gy*CELL);ctx.lineTo(W*CELL,gy*CELL);ctx.stroke();}\n"
    js = js + "if(FRAMES.length==0){ctx.fillStyle='#fff';ctx.fillText('carregando...',10,20);return;}\n"
    js = js + "var f=FRAMES[i];var flat=f[0],fx=f[1],fy=f[2],sc=f[3];\n"
    js = js + "ctx.fillStyle='#ff5252';ctx.beginPath();ctx.arc(fx*CELL+CELL/2,fy*CELL+CELL/2,CELL/2-3,0,6.29);ctx.fill();\n"
    js = js + "for(var k=0;k<flat.length;k+=2){var last=(k+2>=flat.length);ctx.fillStyle=last?'#00e676':'#69f0ae';ctx.fillRect(flat[k]*CELL+1,flat[k+1]*CELL+1,CELL-2,CELL-2);}\n"
    js = js + "document.getElementById('stepLbl').textContent=i+'/'+(FRAMES.length-1);\n"
    js = js + "document.getElementById('scoreLbl').textContent=sc;\n"
    js = js + "}\n"
    js = js + "function loop(){if(!playing||FRAMES.length==0)return;idx=(idx+1)%FRAMES.length;draw(idx);}\n"
    js = js + "function startTimer(){if(timer)clearInterval(timer);timer=setInterval(loop,speed);}\n"
    js = js + "document.getElementById('playBtn').onclick=function(){playing=!playing;this.textContent=playing?'Pausar':'Jogar';};\n"
    js = js + "document.getElementById('restartBtn').onclick=function(){idx=0;draw(0);};\n"
    js = js + "document.getElementById('speed').oninput=function(){speed=830-this.value;startTimer();};\n"
    js = js + "function selectDemo(k){FRAMES=DEMOS[k][2];idx=0;document.getElementById('demoLbl').textContent='ep '+DEMOS[k][0]+' - '+DEMOS[k][1]+' pontos';draw(0);}\n"
    js = js + "fetch('/api/frames').then(function(r){return r.json();}).then(function(d){\n"
    js = js + "if(!d.demos){document.getElementById('stepLbl').textContent='sem dados: rode kof run snake_ai.kof na raiz do projeto';return;}\n"
    js = js + "DEMOS=d.demos;SCORES=d.scores;W=d.w;H=d.h;\n"
    js = js + "var sel=document.getElementById('epSel');\n"
    js = js + "for(var k=0;k<DEMOS.length;k++){var o=document.createElement('option');o.value=k;o.text='ep '+DEMOS[k][0]+' - '+DEMOS[k][1]+' pts';sel.appendChild(o);}\n"
    js = js + "sel.value=DEMOS.length-1;\n"
    js = js + "sel.onchange=function(){selectDemo(parseInt(this.value));};\n"
    js = js + "selectDemo(DEMOS.length-1);\n"
    js = js + "document.getElementById('metaLbl').textContent=d.episodes+' episodios, melhor '+d.best;\n"
    js = js + "draw(0);startTimer();\n"
    js = js + "}).catch(function(){document.getElementById('stepLbl').textContent='rode kof run snake_ai.kof primeiro';});\n"
    js = js + "var LIVE=[];\n"
    js = js + "function drawLive(){\n"
    js = js + "var lc=document.getElementById('live');var c=lc.getContext('2d');\n"
    js = js + "c.fillStyle='#111';c.fillRect(0,0,lc.width,lc.height);\n"
    js = js + "if(LIVE.length==0){c.fillStyle='#fff';c.fillText('aguardando treino...',10,20);return;}\n"
    js = js + "var mx=0;for(var i=0;i<LIVE.length;i++){if(LIVE[i].score>mx)mx=LIVE[i].score;}\n"
    js = js + "if(mx==0)mx=1;\n"
    js = js + "c.strokeStyle='#00e676';c.beginPath();\n"
    js = js + "for(var i=0;i<LIVE.length;i++){var x=30+i/(LIVE.length-1||1)*(lc.width-40);var y=lc.height-20-(LIVE[i].score/mx)*(lc.height-40);if(i==0)c.moveTo(x,y);else c.lineTo(x,y);}\n"
    js = js + "c.stroke();\n"
    js = js + "var last=LIVE[LIVE.length-1];\n"
    js = js + "document.getElementById('liveEp').textContent=last.ep;\n"
    js = js + "document.getElementById('liveScore').textContent=last.score;\n"
    js = js + "document.getElementById('liveBest').textContent=last.best;\n"
    js = js + "}\n"
    js = js + "setInterval(function(){fetch('/api/progress').then(function(r){return r.text();}).then(function(t){\n"
    js = js + "var lines=t.split('\\n');LIVE=[];\n"
    js = js + "for(var i=0;i<lines.length;i++){if(lines[i].length>2){try{LIVE.push(JSON.parse(lines[i]));}catch(e){}}}\n"
    js = js + "drawLive();\n"
    js = js + "}).catch(function(){});\n"
    js = js + "},1000);\n"
    js = js + "draw(0);\n"
    js = js + "drawLive();\n"
    return js
}

main() {
    var app = web.app()
    app.get("/") {
        headerSet("Content-Type", "text/html")
        return playerPage()
    }
    app.get("/app.js") {
        headerSet("Content-Type", "application/javascript")
        return playerJs()
    }
    app.get("/api/frames") {
        var raw = File("frames.json").readText()
        if (raw == null) { return "{\"error\":\"rode kof run snake_ai.kof primeiro\"}" }
        return raw
    }
    app.get("/api/progress") {
        var raw = File("progress.jsonl").readText()
        if (raw == null) { return "" }
        return raw
    }
    println("servidor Kof no ar: http://localhost:8888")
    app.listen(8888)
}
