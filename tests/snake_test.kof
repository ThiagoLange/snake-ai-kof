// tests/snake_test.kof — copias das funções de ../snake_ai.kof + asserts.
// Run: kof test tests/snake_test.kof (a partir da raiz snake-ai-kof)
// Sem classes/records aqui: só funções top-level sobre listas.

lcgNext(List<Int> rng): Int {
    var s = rng.get(0)
    var nxt = (s * 25173 + 13849) % 65521
    rng.set(0, nxt)
    return nxt
}

randInt(List<Int> rng, Int n): Int {
    if (n <= 0) { throw "randInt: n must be > 0" }
    return lcgNext(rng) % n
}

randDouble(List<Int> rng): Double {
    var r = lcgNext(rng)
    return (1.0 * r) / 65521.0
}

relDir(Int heading, Int turn): Int {
    if (turn == 0) { return heading }
    if (turn == 1) { return (heading + 1) % 4 }
    return (heading + 3) % 4
}

headingDx(Int h): Int {
    if (h == 0) { return 0 }
    if (h == 1) { return 1 }
    if (h == 2) { return 0 }
    return -1
}

headingDy(Int h): Int {
    if (h == 0) { return -1 }
    if (h == 1) { return 0 }
    if (h == 2) { return 1 }
    return 0
}

encodeState(Int dS, Int dR, Int dL, Int fA, Int fL, Int fR): Int {
    return dS + dR * 2 + dL * 4 + fA * 8 + fL * 16 + fR * 32
}

gameLen(List<Int> xs): Int { return xs.size() }

gameHeadX(List<Int> xs): Int { return xs.get(xs.size() - 1) }

gameHeadY(List<Int> ys): Int { return ys.get(ys.size() - 1) }

gameDir(List<Int> box): Int { return box.get(0) }

gameSetDir(List<Int> box, Int d): Int { box.set(0, d); return 0 }

gameFoodX(List<Int> box): Int { return box.get(1) }

gameFoodY(List<Int> box): Int { return box.get(2) }

gameSetFood(List<Int> box, Int x, Int y): Int { box.set(1, x); box.set(2, y); return 0 }

gameScore(List<Int> box): Int { return box.get(3) }

gameAddScore(List<Int> box, Int d): Int { box.set(3, box.get(3) + d); return 0 }

gameOver(List<Int> box): Int { return box.get(4) }

gameSetOver(List<Int> box, Int v): Int { box.set(4, v); return 0 }

gameSteps(List<Int> box): Int { return box.get(5) }

gameIncSteps(List<Int> box): Int { box.set(5, box.get(5) + 1); return 0 }

gameWid(List<Int> box): Int { return box.get(6) }

gameHei(List<Int> box): Int { return box.get(7) }

gamePushHead(List<Int> xs, List<Int> ys, Int x, Int y): Int { xs.add(x); ys.add(y); return 0 }

gamePopTail(List<Int> xs, List<Int> ys): Int { xs.remove(0); ys.remove(0); return 0 }

newGame(List<Int> xs, List<Int> ys, List<Int> box, Int w, Int h, List<Int> rng): Int {
    var cx = w / 2
    var cy = h / 2
    xs.add(cx - 2); ys.add(cy)
    xs.add(cx - 1); ys.add(cy)
    xs.add(cx); ys.add(cy)
    box.add(1)
    box.add(0)
    box.add(0)
    box.add(0)
    box.add(0)
    box.add(0)
    box.add(w)
    box.add(h)
    spawnFood(xs, ys, box, rng)
    return 0
}

spawnFood(List<Int> xs, List<Int> ys, List<Int> box, List<Int> rng): Int {
    var ex = listOf<Int>()
    var ey = listOf<Int>()
    var x = 0
    while (x < gameWid(box)) {
        var y = 0
        while (y < gameHei(box)) {
            if (cellBlocked(xs, ys, box, x, y, 0) == 0) {
                ex.add(x)
                ey.add(y)
            }
            y = y + 1
        }
        x = x + 1
    }
    if (ex.size() == 0) {
        gameSetOver(box, 1)
        return 0
    }
    var idx = randInt(rng, ex.size())
    gameSetFood(box, ex.get(idx), ey.get(idx))
    return 1
}

cellBlocked(List<Int> xs, List<Int> ys, List<Int> box, Int x, Int y, Int ignoreTail): Int {
    if (x < 0 || y < 0 || x >= gameWid(box) || y >= gameHei(box)) { return 1 }
    var n = gameLen(xs)
    var lim = n
    if (ignoreTail == 1) { lim = n - 1 }
    var i = 0
    while (i < lim) {
        if (xs.get(i) == x && ys.get(i) == y) { return 1 }
        i = i + 1
    }
    return 0
}

manhattan(Int x0, Int y0, Int x1, Int y1): Int {
    var dx = x0 - x1
    if (dx < 0) { dx = -dx }
    var dy = y0 - y1
    if (dy < 0) { dy = -dy }
    return dx + dy
}

stepGame(List<Int> xs, List<Int> ys, List<Int> box, Int action, List<Int> rng): Double {
    var nd = relDir(gameDir(box), action)
    var nx = gameHeadX(xs) + headingDx(nd)
    var ny = gameHeadY(ys) + headingDy(nd)
    var before = manhattan(gameHeadX(xs), gameHeadY(ys), gameFoodX(box), gameFoodY(box))
    if (cellBlocked(xs, ys, box, nx, ny, 1) == 1) {
        gameSetOver(box, 1)
        return -10.0
    }
    gamePushHead(xs, ys, nx, ny)
    gameSetDir(box, nd)
    gameIncSteps(box)
    if (nx == gameFoodX(box) && ny == gameFoodY(box)) {
        gameAddScore(box, 1)
        spawnFood(xs, ys, box, rng)
        return 10.0
    }
    gamePopTail(xs, ys)
    var after = manhattan(gameHeadX(xs), gameHeadY(ys), gameFoodX(box), gameFoodY(box))
    var shaping = before - after
    return 1.0 * shaping
}

qIndex(List<Int> keys, Int s): Int {
    var i = 0
    var n = keys.size()
    while (i < n) {
        if (keys.get(i) == s) { return i }
        i = i + 1
    }
    return -1
}

qEnsure(List<Int> keys, List<Double> vals, Int s): Int {
    var idx = qIndex(keys, s)
    if (idx != -1) { return idx }
    keys.add(s)
    vals.add(0.0)
    vals.add(0.0)
    vals.add(0.0)
    return keys.size() - 1
}

qGet(List<Int> keys, List<Double> vals, Int s, Int a): Double {
    var idx = qEnsure(keys, vals, s)
    return vals.get(idx * 3 + a)
}

qMax(List<Int> keys, List<Double> vals, Int s): Double {
    var idx = qEnsure(keys, vals, s)
    var best = vals.get(idx * 3)
    if (vals.get(idx * 3 + 1) > best) { best = vals.get(idx * 3 + 1) }
    if (vals.get(idx * 3 + 2) > best) { best = vals.get(idx * 3 + 2) }
    return best
}

qLearn(List<Int> keys, List<Double> vals, Int s, Int a, Double r, Double nextMax, Double alpha, Double gamma): Double {
    var idx = qEnsure(keys, vals, s)
    var q = vals.get(idx * 3 + a)
    var target = r + gamma * nextMax
    var updated = q + alpha * (target - q)
    vals.set(idx * 3 + a, updated)
    return updated
}

chooseAction(List<Int> keys, List<Double> vals, Int s, Double eps, List<Int> rng): Int {
    var roll = randDouble(rng)
    if (roll < eps) { return randInt(rng, 3) }
    var best = 0
    var bestV = qGet(keys, vals, s, 0)
    if (qGet(keys, vals, s, 1) > bestV) { best = 1; bestV = qGet(keys, vals, s, 1) }
    if (qGet(keys, vals, s, 2) > bestV) { best = 2 }
    return best
}

// ─── tests ─────────────────────────────────────────────────────────────

test "rng deterministico" {
    var r1 = listOf<Int>()
    r1.add(12345)
    var r2 = listOf<Int>()
    r2.add(12345)
    assert(lcgNext(r1) == lcgNext(r2), "mesma seed, mesma sequencia")
    assert(lcgNext(r1) == lcgNext(r2), "segundo valor igual")
}

test "randInt dentro dos limites" {
    var rng = listOf<Int>()
    rng.add(7)
    var i = 0
    while (i < 100) {
        var v = randInt(rng, 10)
        assert(v >= 0 && v < 10, "0<=v<10")
        i = i + 1
    }
}

test "encodeState matematica" {
    assert(encodeState(1, 0, 1, 0, 1, 0) == 21, "1+4+16=21")
    assert(encodeState(0, 0, 0, 0, 0, 0) == 0, "zero")
    assert(encodeState(1, 1, 1, 1, 1, 1) == 63, "63")
}

test "relDir relativo" {
    assert(relDir(0, 0) == 0, "up reto")
    assert(relDir(0, 1) == 1, "up direita -> right")
    assert(relDir(0, 2) == 3, "up esquerda -> left")
    assert(relDir(3, 1) == 0, "left direita -> up")
}

test "comer aumenta pontos e cresce" {
    var rng = listOf<Int>()
    rng.add(99)
    var xs = listOf<Int>()
    var ys = listOf<Int>()
    var box = listOf<Int>()
    newGame(xs, ys, box, 6, 6, rng)
    gameSetFood(box, 4, 3)
    var r = stepGame(xs, ys, box, 0, rng)
    assert(r == 10.0, "recompensa comer")
    assert(gameScore(box) == 1, "score 1")
    assert(gameLen(xs) == 4, "cresceu")
    assert(gameOver(box) == 0, "vivo")
}

test "bater na parede morre" {
    var rng = listOf<Int>()
    rng.add(5)
    var xs = listOf<Int>()
    var ys = listOf<Int>()
    var box = listOf<Int>()
    newGame(xs, ys, box, 6, 6, rng)
    gameSetDir(box, 3)
    var i = 0
    var last = 0.0
    while (i < 4) {
        last = stepGame(xs, ys, box, 0, rng)
        i = i + 1
    }
    assert(gameOver(box) == 1, "morreu na parede")
    assert(last == -10.0, "recompensa morte")
}

test "qLearn formula" {
    var keys = listOf<Int>()
    var vals = listOf<Double>()
    var q = qLearn(keys, vals, 5, 1, 10.0, 4.0, 0.5, 0.9)
    var d = q - 6.8
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "0.5*(10+0.9*4)=6.8")
}

test "chooseAction guloso" {
    var rng = listOf<Int>()
    rng.add(1)
    var keys = listOf<Int>()
    var vals = listOf<Double>()
    qLearn(keys, vals, 9, 0, 1.0, 0.0, 1.0, 0.0)
    qLearn(keys, vals, 9, 2, 5.0, 0.0, 1.0, 0.0)
    var a = chooseAction(keys, vals, 9, 0.0, rng)
    assert(a == 2, "melhor acao 2")
}
